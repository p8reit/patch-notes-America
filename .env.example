# Browser-facing ports. Change the bind addresses to 0.0.0.0 for remote access.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8081
KOKORO_BIND_ADDRESS=127.0.0.1
KOKORO_PORT=7860

# Set this when Kokoro is exposed through a hostname, reverse proxy, or HTTPS URL.
# When blank, the UI uses the same hostname as Patch Notes and KOKORO_PORT.
KOKORO_PUBLIC_URL=

# API paths exposed by the hangrylabs/kokorotts image.
KOKORO_TTS_PATH=/tts/generate
KOKORO_HEALTH_PATH=/tts/status
KOKORO_TIMEOUT_SECONDS=180
# Keep one worker on CPU-only hosts; increase only when the TTS backend has spare capacity.
JOB_WORKERS=1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
CONVERSATION_PROVIDER=openai

# The published Kokoro image is amd64; Docker Desktop emulates it on ARM hosts.
KOKORO_PLATFORM=linux/amd64

# Use "local" above to send conversation prompts to the optional Ollama service.
LOCAL_AI_URL=http://ollama:11434/api/chat
LOCAL_AI_MODEL=llama3.1:8b
OLLAMA_BIND_ADDRESS=127.0.0.1
OLLAMA_PORT=11434
