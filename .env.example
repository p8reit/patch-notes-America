# Browser-facing ports. Change the bind addresses to 0.0.0.0 for remote access.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8081
CHATTERBOX_BIND_ADDRESS=127.0.0.1
CHATTERBOX_PORT=8000

# Set this when Chatterbox is exposed through a hostname, reverse proxy, or HTTPS URL.
# When blank, the UI uses the same hostname as Patch Notes and CHATTERBOX_PORT.
CHATTERBOX_PUBLIC_URL=
CHATTERBOX_TTS_PATH=/v1/audio/speech
CHATTERBOX_HEALTH_PATH=/health
# Initial model download and CPU inference can take several minutes.
CHATTERBOX_TIMEOUT_SECONDS=600
CHATTERBOX_EXAGGERATION=0.5
CHATTERBOX_CFG_WEIGHT=0.5
# Reject requests which can exhaust the model's acoustic-token window.
CHATTERBOX_MAX_INPUT_CHARS=300
# Maximum reference recording upload size in megabytes.
MAX_VOICE_UPLOAD_MB=50
# Maximum music/sound-design intro upload size in megabytes.
MAX_INTRO_TRACK_MB=50

# Keep one worker on CPU-only hosts; increase only when the TTS backend has spare capacity.
JOB_WORKERS=1
# Retry transient TTS crashes/disconnects. Delays increase after each attempt.
TTS_MAX_ATTEMPTS=5
TTS_RETRY_DELAY_SECONDS=15
# Keep generated utterances short enough for Chatterbox to finish cleanly.
MAX_CHARS_PER_CHUNK=280

# Audio detection and timing. A more-negative threshold detects quieter speech.
SILENCE_THRESHOLD_DB=-45
# Maximum silence retained at the start/end of each generated speech chunk.
MAX_LEADING_SILENCE_MS=250
MAX_TRAILING_SILENCE_MS=350
# Extra protection around detected speech so quiet consonants are not clipped.
SPEECH_SAFETY_BUFFER_MS=40
# Intentional pauses inserted between rendered chunks.
SAME_SPEAKER_PAUSE_MS=225
NORMAL_TRANSITION_PAUSE_MS=400
TECHNICAL_CONTINUATION_PAUSE_MS=0
SPEAKER_CHANGE_PAUSE_MS=500
SECTION_CHANGE_PAUSE_MS=600
DRAMATIC_PAUSE_MS=1000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGES_URL=https://api.openai.com/v1/images/generations
CONVERSATION_PROVIDER=openai

# Use "local" above to send conversation prompts to the optional Ollama service.
LOCAL_AI_URL=http://ollama:11434/api/chat
LOCAL_AI_MODEL=llama3.1:8b
OLLAMA_BIND_ADDRESS=127.0.0.1
OLLAMA_PORT=11434
