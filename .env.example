# Host-side settings. Container ports remain fixed and private to this project.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8081

# Used by docker-compose.full.yml when it starts Kokoro for this project.
KOKORO_BIND_ADDRESS=127.0.0.1
KOKORO_PORT=7860

# Used by docker-compose.yml when Kokoro is already running on the Docker host.
KOKORO_URL=http://host.docker.internal:7860
