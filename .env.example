# Host-side settings. Container ports remain fixed and private to this project.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8081

# Kokoro always starts with Patch Notes and is also available on the host here.
KOKORO_BIND_ADDRESS=127.0.0.1
KOKORO_PORT=7860
# The published Kokoro image is amd64; Docker Desktop emulates it on ARM hosts.
KOKORO_PLATFORM=linux/amd64
# Maximum time to wait for each generated audio chunk.
KOKORO_TIMEOUT_SECONDS=180

# Required only for AI conversation drafting. Create a project API key at
# https://platform.openai.com/api-keys, then replace the blank value in .env.
# Never commit the real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
